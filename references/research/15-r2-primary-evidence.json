  "sources": [
    {
      "title": "1792《启示批判尝试》§3",
      "url": "https://www.tha.de/homes/harsch/germanica/Chronologie/19Jh/Fichte/fic_ve03.html",
      "actual_reading": "抽样完整h3段20个，另实读5、8、23、24、31–33；20–26形成连续核心论证。前一工具整页输出发生截断，不计全§3通读。",
      "version": "Augustana版本页fic_ve00.html声明据1792初印，1793第二版变化在脚注。样本排除脚注；未逐页核对初印扫描。"
    },
    {
      "title": "版本说明",
      "url": "https://www.tha.de/~harsch/germanica/Chronologie/19Jh/Fichte/fic_ve00.html",
      "actual_reading": "标题、底本说明、目录",
      "version": "初印Königsberg, Hartung 1792；版本声明已读，所链1793影印未读。"
    }
  ],
  "argument_chains": [
    {
      "title": "派生权威不能提供其自身根据",
      "locator": "§3 h3[20]–[26]",
      "premise": "文本从实践理性取得神的概念及服从的根据。",
      "reasoning": "既然承认神的命令有效已预设理性法则，神命令便不能再成为该法则原初效力的证明；但在具体诱惑中，这种表象可以加强贯彻既认义务的动力。",
      "limit": "原文区分效力与动机，并没有否认宗教生活；1792早期论证不能未经说明与1797、1800全部并同。"
    },
    {
      "title": "内容同一不等于来源同一",
      "locator": "§3 h3[28]–[33]",
      "premise": "两个命令内容相同，还没有证明其中一个是另一个的颁布或原因。",
      "reasoning": "文本拆分内容与形式，再把上帝为道德律原因分为内容之因与在我们心中存在之因；前者被拒为他律，后者需另问证据。",
      "limit": "不能由共同内容推断同一来源；不能用理论因果范畴随意证明超感性对象。"
    },
    {
      "title": "愿望、要求与实际因果能力",
      "locator": "§3 h3[8]、[12]、[13]及[17]",
      "premise": "希望某对象存在本身不足以证明它真实。",
      "reasoning": "原作把依对象满足的欲望，与不由对象先行赋予规范理由的意志分开；再分内在可由我行动实现的要求和外在不可直接支配的结果。",
      "limit": "这是作者的早期实践理性论证，不是保证善意一定成功，更不是把他人自由作为可操控自然对象。"
    },
    {
      "title": "精确复述后才使用自反检验",
      "locator": "研究者防误用规则；依存检查的原作依据：1797第一导论§§5–7与1792启示批判§3[23]–[26]",
      "premise": "有条件的承认与全面否定不是同一命题。",
      "reasoning": "先保持原主张的量词、模态与范围；只有该主张实际否认其成立所必需的条件，才可以作自反追问。检验依存方向时，还须区分逻辑根据与实际执行动力。",
      "limit": "此条是研究者的防误用规则，不伪装成原作逐字法则。"
    }
  ],
